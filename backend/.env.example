# Server Configuration
PROJECT_NAME="AI Trading Copilot"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
HOST="127.0.0.1"
PORT=8000

# CORS (Comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration
# Default to local async sqlite for initial scaffolding/testing; PostgreSQL for production
DATABASE_URL="sqlite+aiosqlite:///./trading_copilot.db"
# Example PostgreSQL with asyncpg:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/trading_copilot"

# Security & Encryption (JWT / Investor Passwords)
SECRET_KEY="generate-a-secure-random-secret-key-for-jwt-signing"
ENCRYPTION_KEY="generate-a-32-byte-base64-key-for-aes-256-gcm="
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MetaTrader 5 Configuration
MT5_TERMINAL_PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe"
MT5_TIMEOUT_SECONDS=30


