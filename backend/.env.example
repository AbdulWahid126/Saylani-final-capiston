# Server Configuration
PROJECT_NAME="AI Trading Copilot"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
HOST="127.0.0.1"
PORT=8000

# CORS (Comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration
# Default to local async sqlite for initial scaffolding/testing; PostgreSQL for production
DATABASE_URL="sqlite+aiosqlite:///./trading_copilot.db"
# Local PostgreSQL with asyncpg:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/trading_copilot"
# Supabase Connection Pooler (Recommended for IPv4 networks, Session mode port 5432):
# DATABASE_URL="postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require"
# Supabase Direct Connection (Requires IPv6 network):
# DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?ssl=require"

# Security & Encryption (JWT / Investor Passwords)
SECRET_KEY="generate-a-secure-random-secret-key-for-jwt-signing"
ENCRYPTION_KEY="generate-a-32-byte-base64-key-for-aes-256-gcm="
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MetaTrader 5 Configuration
MT5_TERMINAL_PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe"
MT5_TIMEOUT_SECONDS=30

# Personal Playbook RAG & Embeddings
EMBEDDING_PROVIDER="mock"  # "openai", "gemini", "mock"
EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
LLM_PROVIDER="mock"        # "openai", "gemini", "mock"
LLM_MODEL="gpt-4o-mini"
RAG_SIMILARITY_THRESHOLD=0.25
RAG_TOP_K=4

# Vision Analyzer (TASK-014)
VISION_PROVIDER="mock"      # "openai", "gemini", "mock"
VISION_MODEL="gpt-4o-mini"
